# Git pre-push hook for the PUBLIC repository: export every commit being pushed and refuse the push unless
# check.sh is clean. Install it in the clone that pushes to GitHub (never needed for private repository):
#   cp tools/public-export/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Git passes <local ref> <local sha> <remote ref> <remote sha> lines on stdin.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
tools=$(git rev-parse --show-toplevel)/tools/public-export
[ -x "$tools/check.sh" ] || tools=$here
status=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue   # branch deletion
  if [ "$rsha" = "0000000000000000000000000000000000000000" ]; then
    commits=$(git rev-list "$lsha" --not --remotes="${1:-origin}") || exit 1
  else
    commits=$(git rev-list "$lsha" "^$rsha") || exit 1
  fi
  for commit in $commits; do
  tmp=$(mktemp -d)
  if ! git archive --format=tar "$commit" | tar -x -C "$tmp"; then
    echo "pre-push: cannot inspect $commit"; status=1
  fi
  if ! "$tools/check.sh" "$tmp"; then echo "pre-push: $commit is not clean for the public repository"; status=1; fi
  if grep -rIlq "PLACE"'HOLDER' "$tmp" --exclude-dir=node_modules; then echo "pre-push: $commit still has unfilled publication values"; status=1; fi
  rm -rf "$tmp"
  done
done
exit $status
