{
  "name": "@symvoulio/ui",
  "version": "0.3.1",
  "private": true,
  "description": "The UI kit used by Symvoulio: tokens, frame, components, collapsing banners and internationalization.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/fonts.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/styles/theme.css",
    "./fonts": "./src/fonts.ts",
    "./theme": "./src/theme.ts",
    "./tokens": "./src/tokens.ts",
    "./i18n": "./src/i18n/index.ts",
    "./components": "./src/components/ui.tsx",
    "./charts": "./src/components/charts.tsx",
    "./virtual-rows": "./src/components/VirtualRows.tsx",
    "./banner": "./src/banner/Banner.tsx",
    "./frame": "./src/frame/index.ts",
    "./testing/pseudo": "./testing/pseudo.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "i18n:check": "python scripts/i18n_check.py"
  },
  "peerDependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "clsx": "^2.1.1",
    "i18next": "^26.5.11",
    "i18next-http-backend": "^4.0.6",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^7.18.5",
    "tailwindcss": "^4.3.3"
  }
}
